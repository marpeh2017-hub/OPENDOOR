// ============================================================
// DATA QUALITY CENTER (SQLite mirror of schema.postgres.prisma)
// Divergence from Postgres:
//   - Json  -> String (JSON-encoded)
//   - String[] -> String (JSON-encoded array)
// Postgres remains the canonical schema.
// ============================================================

enum DataQualitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum DataQualityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum DataQualityCategory {
  COMPLETENESS
  ACCURACY
  CONSISTENCY
  INTEGRITY
  DUPLICATION
  TIMELINESS
  COMPLIANCE
}

enum DataQualityEntityType {
  PROJECT
  COMPLEX
  BUILDING
  APARTMENT
  OWNER
  OWNER_APARTMENT
  RESIDENT
  SIGNATURE_PACKAGE
  SIGNATURE_RECORD
  DOCUMENT
  TASK
  MESSAGE
  MEETING
  LEAD
  USER
}

enum DataQualityScanScope {
  PROJECT
  TENANT
  GLOBAL
}

enum DataQualityScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

model DataQualityIssue {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String?

  entityType  DataQualityEntityType
  entityId    String
  entityLabel String

  issueType   String
  category    DataQualityCategory
  severity    DataQualitySeverity
  status      DataQualityStatus     @default(OPEN)

  title          String
  description    String
  impact         String?
  recommendation String?
  deepLink       String?
  metadata       String?

  detectedAt  DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  scanId      String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  resolutionType String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, issueType, entityType, entityId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, category])
  @@index([tenantId, issueType])
  @@index([tenantId, projectId, status])
  @@index([entityType, entityId])
  @@index([tenantId, detectedAt])
  @@map("data_quality_issues")
}

model DataQualityScan {
  id            String                @id @default(cuid())
  tenantId      String
  scope         DataQualityScanScope
  projectId     String?
  status        DataQualityScanStatus @default(RUNNING)

  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?

  rulesExecuted String    @default("[]")
  ruleCount     Int       @default(0)
  entitiesScanned Int     @default(0)
  issuesFound     Int     @default(0)
  issuesNew       Int     @default(0)
  issuesResolved  Int     @default(0)
  errors          String?

  triggeredById String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, startedAt])
  @@index([tenantId, projectId])
  @@map("data_quality_scans")
}
