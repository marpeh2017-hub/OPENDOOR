  additionalAreaSqm  Decimal?                     @db.Decimal(18, 4)
  balconyAreaSqm     Decimal?                     @db.Decimal(18, 4)
  parkingSpaces      Int                          @default(0)
  storageAreaSqm     Decimal?                     @db.Decimal(18, 4)
  newFloor           Int?
  replacementValue   Decimal?                     @db.Decimal(18, 2)
  parkingValue       Decimal?                     @db.Decimal(18, 2)
  storageValue       Decimal?                     @db.Decimal(18, 2)
  balconyValue       Decimal?                     @db.Decimal(18, 2)
  cashCompensation   Decimal?                     @db.Decimal(18, 2)
  monthlyRelocationRent Decimal?                  @db.Decimal(18, 2)
  relocationMonths   Int?
  movingCost         Decimal?                     @db.Decimal(18, 2)
  temporaryHousingCost Decimal?                   @db.Decimal(18, 2)
  legalCost          Decimal?                     @db.Decimal(18, 2)
  inspectionCost     Decimal?                     @db.Decimal(18, 2)
  otherCost          Decimal?                     @db.Decimal(18, 2)
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence        @default(UNKNOWN)
  isVerified         Boolean                      @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime                     @default(now())
