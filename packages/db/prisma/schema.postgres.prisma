// ── Data Quality Center ─────────────────────────────────────

enum DataQualitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum DataQualityStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
}

enum DataQualityCategory {
  COMPLETENESS   // a required value is missing
  ACCURACY       // a value exists but is malformed / out of range
  CONSISTENCY    // two values that should agree do not
  INTEGRITY      // a relationship is broken / orphaned
  DUPLICATION    // the same real-world entity appears twice
  TIMELINESS     // something is stale / overdue / expired
  COMPLIANCE     // regulatory or process prerequisite missing
}

enum DataQualityEntityType {
  PROJECT
  COMPLEX
  BUILDING
  APARTMENT
  OWNER
  OWNER_APARTMENT
  RESIDENT
  SIGNATURE_PACKAGE
  SIGNATURE_RECORD
  DOCUMENT
  TASK
  MESSAGE
  MEETING
  LEAD
  USER
}

enum DataQualityScanScope {
  PROJECT
  TENANT
  GLOBAL
}

enum DataQualityScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One logical data-quality problem about one entity.
/// The natural key (tenantId, issueType, entityType, entityId) is unique so
/// re-scans UPSERT rather than duplicate.
model DataQualityIssue {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String?

  entityType  DataQualityEntityType
  entityId    String
  entityLabel String

  issueType   String
  category    DataQualityCategory
  severity    DataQualitySeverity
  status      DataQualityStatus     @default(OPEN)

  title          String
  description    String
  /// Why it matters — business impact, shown in the CRM detail view.
  impact         String?
  /// Recommended remediation action (human-readable, never auto-applied).
  recommendation String?
  /// CRM deep link to the affected record.
  deepLink       String?
  /// Non-sensitive structured context (never contains PII such as national IDs).
  metadata       Json?

  detectedAt  DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  scanId      String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  /// AUTO when the scanner closed it, MANUAL when a human did.
  resolutionType String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, issueType, entityType, entityId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, category])
  @@index([tenantId, issueType])
  @@index([tenantId, projectId, status])
  @@index([entityType, entityId])
  @@index([tenantId, detectedAt])
  @@map("data_quality_issues")
}

/// Metadata for one execution of the rule engine.
model DataQualityScan {
  id            String                @id @default(cuid())
  tenantId      String
  scope         DataQualityScanScope
  projectId     String?
  status        DataQualityScanStatus @default(RUNNING)

  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?

  rulesExecuted String[]  @default([])
  ruleCount     Int       @default(0)
  entitiesScanned Int     @default(0)
  issuesFound     Int     @default(0)
  issuesNew       Int     @default(0)
  issuesResolved  Int     @default(0)
  errors          Json?

  triggeredById String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, startedAt])
  @@index([tenantId, projectId])
  @@map("data_quality_scans")
}

// ============================================================
// CORE: MULTI-TENANCY
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?  @unique
  logoUrl     String?
  primaryColor String  @default("#2F9DA0")
  website     String?
  email       String?
  phone       String?

  // Settings (JSON blob for flexibility)
  settings    Json     @default("{}")
  features    Json     @default("{}")  // feature flags per tenant

  isActive    Boolean  @default(true)
  trialEndsAt DateTime?
  plan        String   @default("starter") // starter | growth | enterprise

  /// Per-tenant notification retention, in days. NULL means "use the platform
  /// default" (NOTIFICATION_RETENTION_DAYS). An explicit column rather than a
  /// key in `settings` because the retention sweeper DELETES rows on the
  /// strength of it — a value that governs deletion should not live in an
  /// unvalidated JSON blob. Only READ notifications are ever removed, and
  /// audit rows and signature evidence are never touched. See
  /// services/api-gateway/src/notifications/notification-retention.service.ts.
  notificationRetentionDays Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users         User[]
  projects      Project[]
  leads         Lead[]
  documents     Document[]
  workflows     Workflow[]
  templates     CommunicationTemplate[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  campaigns     Campaign[]
  reports       SavedReport[]
  feasibilityProfiles FeasibilityProfile[]
  feasibilityScenarios FeasibilityScenario[]
  feasibilityCalculationSnapshots FeasibilityCalculationSnapshot[]
  feasibilityReportVersions FeasibilityReportVersion[]
  residentInvitations ResidentInvitation[]
  comparableTransactions ComparableTransaction[]
  automations   Automation[]
  notifications Notification[]
  meetings      Meeting[]

  // CMS (Site Manager). Cascade on every one of these: a deleted tenant must
  // not leave published website content, revision history or verification
  // records behind.
  cmsContent           CmsContent[]
  cmsRevisions         CmsRevision[]
  cmsPublications      CmsPublication[]
  cmsVerifications     CmsVerification[]
  cmsVerificationAudit CmsVerificationAudit[]
  cmsMediaReferences   CmsMediaReference[]
  feasibilityRules     FeasibilityRule[]
  feasibilityEquityTranches FeasibilityEquityTranche[]

  @@index([slug])
  @@map("tenants")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email       String?
  phone       String?
  nationalId  String?

  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole
  language    Language @default(he)

  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  lastLoginAt DateTime?

  // Auth
  passwordHash     String?
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?

  // Preferences
  notificationPrefs Json @default("{\"email\":true,\"sms\":true,\"whatsapp\":true,\"push\":true,\"inApp\":true}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions            Session[]
  assignedTasks       Task[]          @relation("TaskAssignee")
  createdTasks        Task[]          @relation("TaskCreator")
  meetings            MeetingAttendee[]
  organisedMeetings   Meeting[]         @relation("MeetingCreator")
  auditLogs           AuditLog[]
  projectMemberships  ProjectMember[]
  notifications       Notification[]
  createdDocuments    Document[]      @relation("DocumentCreator")
  importJobs          ImportJob[]
  importRowDecisions  ImportRowDecision[] @relation("ImportRowDecider")

  // CMS (Site Manager). Named relations throughout, because a user can stand in
  // several different roles against the same row and "who edited it" must stay
  // distinguishable from "who verified it" and "who published it".
  cmsContentCreated     CmsContent[]           @relation("CmsContentCreator")
  cmsContentEdited      CmsContent[]           @relation("CmsContentEditor")
  cmsRevisionsAuthored  CmsRevision[]          @relation("CmsRevisionAuthor")
  cmsPublished          CmsPublication[]       @relation("CmsPublicationPublisher")
  cmsFactsEdited        CmsVerification[]      @relation("CmsVerificationEditor")
  cmsFactsVerified      CmsVerification[]      @relation("CmsVerificationVerifier")
  cmsVerificationAudit  CmsVerificationAudit[] @relation("CmsVerificationAuditActor")
  cmsMediaUploaded      CmsMediaReference[]    @relation("CmsMediaUploader")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String   @unique
  deviceInfo   Json?    // UA, IP, device type
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String?
  email       String?
  address     String?
  city        String?

  // Public website intake. These stay on the lead until a staff member
  // verifies the enquiry and explicitly converts it into project data.
  formType             String?
  submissionId         String?
  estimatedUnits       Int?
  leadType              String?
  projectType           String?
  organizingStatus     String?
  consentContact       Boolean   @default(false)
  consentPrivacy       Boolean   @default(false)
  consentRecordedAt    DateTime?
  privacyPolicyVersion String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  matchedBuildingId     String?
  matchedBuilding       Building? @relation("LeadMatchedBuilding", fields: [matchedBuildingId], references: [id], onDelete: SetNull)
  possibleDuplicateOfId String?
  possibleDuplicateOf   Lead?     @relation("LeadPossibleDuplicates", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  possibleDuplicates    Lead[]    @relation("LeadPossibleDuplicates")

  source      LeadSource @default(OTHER)
  campaignId  String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])

  status      LeadStatus @default(NEW)
  score       Int        @default(0)  // 0-100 AI-powered score
  notes       String?
  tags        String[]   @default([])

  assignedToId String?
  // Note: assignedTo is a User but without tenant constraint here
  // Application layer enforces same-tenant assignment

  // Converted to resident?
  convertedToResidentId String? @unique
  convertedAt DateTime?

  language    Language   @default(he)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activities  LeadActivity[]
  tasks       Task[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@unique([tenantId, submissionId])
  @@index([tenantId, matchedBuildingId])
  @@index([tenantId, possibleDuplicateOfId])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // call | meeting | email | whatsapp | note | status_change
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())
  createdById String?

  @@index([leadId])
  @@map("lead_activities")
}

// ============================================================
// PROJECTS & HIERARCHY
// ============================================================

model Project {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code        String        // Internal code e.g. "TLV-001"
  name        String
  description String?

  city        String
  neighborhood String?
  address     String?
  coordinates Json?         // { lat, lng }

  status      ProjectStatus @default(ACTIVE)
  stage       ProjectStage  @default(DISCOVERY)

  startDate   DateTime?
  targetEndDate DateTime?
  actualEndDate DateTime?

  // Goals
  totalUnits      Int      @default(0)
  signedUnits     Int      @default(0)
  signatureGoal   Int      @default(67) // required % to proceed
  signatureActual Float    @default(0)  // current %

  // Team
  projectManagerId String?
  lawyerId         String?
  architectId      String?
  developerRep     String?

  // Financial
  estimatedBudget Decimal? @db.Decimal(15,2)
  currency        String   @default("ILS")

  settings    Json @default("{}")
  tags        String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  complexes   Complex[]
  members     ProjectMember[]
  stages      ProjectStageHistory[]
  tasks       Task[]
  meetings    Meeting[]
  documents   Document[]
  campaigns   Campaign[]
  reports     SavedReport[]
  feasibilityProfile FeasibilityProfile?
  automations Automation[]
  importJobs  ImportJob[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, stage])
  @@map("projects")
  residentInvitations ResidentInvitation[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      UserRole
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectStageHistory {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage
  enteredAt DateTime     @default(now())
  exitedAt  DateTime?
  notes     String?
  changedById String?

  @@index([projectId])
  @@map("project_stage_history")
}

model Complex {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  address     String?
  coordinates Json?

  status      String   @default("active")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildings   Building[]

  @@index([projectId])
  @@map("complexes")
}

model Building {
  id              String   @id @default(cuid())
  complexId       String
  complex         Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)

  address         String
  streetNumber    String?
  city            String?
  zipCode         String?
  coordinates     Json?

  floors          Int?
  totalApartments Int?
  constructionYear Int?
  buildingClass   String?  // A | B | C

  status          String   @default("active")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apartments      Apartment[]
  matchedLeads    Lead[]      @relation("LeadMatchedBuilding")

  @@index([complexId])
  @@map("buildings")
  residentInvitations ResidentInvitation[]
}

model Apartment {
  id             String   @id @default(cuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  apartmentNumber String
  floor          Int?
  sizeSqm        Float?
  rooms          Float?   // 2.5, 3, 4 etc.
  hasParking     Boolean  @default(false)
  parkingSpots   Int      @default(0)
  hasStorage     Boolean  @default(false)
  storageCount   Int      @default(0)
  hasBalcony     Boolean  @default(false)
  balconySqm     Float?

  notes          String?
  status         String   @default("active")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  residents      Resident[]
  owners         OwnerApartment[]

  @@unique([buildingId, apartmentNumber])
  @@index([buildingId])
  @@map("apartments")
  residentInvitations ResidentInvitation[]
}

// ============================================================
// OWNERSHIP REGISTRY
// Signature validity is computed over ownership SHARES, not
// resident head-count. An apartment can have multiple owners
// (spouses, heirs); an owner can hold multiple apartments.
// ============================================================

model Owner {
  id          String   @id @default(cuid())
  tenantId    String

  fullName    String
  nationalId  String?  // encrypted at app layer before persist
  phone       String?
  email       String?
  addressAbroad String?
  isEstate    Boolean  @default(false) // עיזבון — inheritance not yet settled
  guardianContact String?              // legal guardian / POA holder contact
  notes       String?

  // Soft-archive. Owners are never hard-deleted: OwnerApartment and
  // SignatureRecord cascade from Owner, so a delete would destroy the ownership
  // shares and signed evidence behind a reported threshold.
  isActive    Boolean  @default(true)

  residentId  String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holdings    OwnerApartment[]
  signatures  SignatureRecord[]

  @@index([tenantId])
  @@map("owners")
}

model OwnerApartment {
  id             String    @id @default(cuid())
  ownerId        String
  owner          Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apartmentId    String
  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  shareNumerator   Int @default(1)
  shareDenominator Int @default(1)

  viaInheritance Boolean @default(false)
  poaHolderId    String?
  acquiredAt     DateTime?

  createdAt      DateTime @default(now())

  feasibilityCompensations FeasibilityCompensationLine[]
  feasibilityReplacementAllocations FeasibilityReplacementAllocation[]

  @@unique([ownerId, apartmentId])
  @@index([apartmentId])
  @@map("owner_apartments")
}

model SignaturePackage {
  id           String   @id @default(cuid())
  tenantId     String
  projectId    String
  version      Int      @default(1)
  // DRAFT → INTERNAL_REVIEW → APPROVED → SENT → PARTIALLY_SIGNED
  // → COMPLETED | DECLINED | EXPIRED | CANCELLED | SUPERSEDED
  status       String   @default("DRAFT")
  title        String
  documentIds  String   @default("[]")
  documentHash String?
  signingOrder String   @default("PARALLEL")
  verificationMethod String @default("SMS_OTP")
  expiresAt    DateTime?
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  supersededById String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evidencePackageKey String?
  providerName       String   @default("NATIVE")
  providerEnvelopeId String?

  records  SignatureRecord[]
  events   SignatureEvent[]
  evidence SignatureEvidence?

  @@index([projectId])
  @@index([tenantId, status])
  @@map("signature_packages")
}

model SignatureEvent {
  id        String   @id @default(cuid())
  packageId String
  package   SignaturePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  recordId  String?
  type      String
  actorType String   @default("SYSTEM")
  actorId   String?
  ip        String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([packageId, createdAt])
  @@map("signature_events")
}

model SigningSession {
  id           String   @id @default(cuid())
  recordId     String   @unique
  token        String   @unique
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int      @default(0)
  verifiedAt   DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@map("signing_sessions")
