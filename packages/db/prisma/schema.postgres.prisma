  tenantId     String
  documentHash String
  signedAt     DateTime
  signers      String
  auditLog     String
  ipAddresses  String
  s3Key        String?
  evidenceHash String?
  pdfBase64    String?
  pdfS3Key     String?
  createdAt    DateTime @default(now())

  @@map("signature_evidence")
}

model ThresholdRule {
  id          String  @id @default(cuid())
  tenantId    String
  projectId   String
  scope       String  @default("PROJECT")  // PROJECT | BUILDING
  buildingId  String?
  requiredPct Float   @default(67)
  basis       String  @default("SHARES")   // SHARES | UNITS
  createdAt   DateTime @default(now())

  @@unique([projectId, scope, buildingId])
  @@map("threshold_rules")
}

// ============================================================
// RESIDENTS
// ============================================================

model Resident {
  id          String   @id @default(cuid())
  tenantId    String
  // Note: tenant relation enforced at app layer via apartmentId -> building -> complex -> project -> tenant

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  firstName   String
  lastName    String
  nationalId  String?  // תעודת זהות
  phone       String?
  phone2      String?
  email       String?

  // Ownership
  ownershipPercentage Float @default(100)  // for jointly owned apartments
  isPrimaryContact    Boolean @default(true)

  // Engagement
  signatureStatus   ResidentSignatureStatus @default(NOT_CONTACTED)
  isObjecting       Boolean @default(false)
  objectionReason   String?
  riskScore         Int     @default(0)  // 0-100, AI computed

  // Communication preferences
  language              Language  @default(he)
  preferredChannel      MessageChannel @default(WHATSAPP)
  whatsappOptIn         Boolean   @default(false)
  smsOptIn              Boolean   @default(true)
  emailOptIn            Boolean   @default(true)
  doNotContact          Boolean   @default(false)
  doNotContactReason    String?

  // Portal access
  portalUserId  String?  @unique  // links to User with role=RESIDENT — can they log in at all
  // Narrower than the above: only whether the in-portal message inbox is
  // reachable as a delivery channel. Renamed from `portalEnabled`, which read
  // as the login gate and was not.
  portalInboxEnabled Boolean @default(false)

  notes     String?
  tags      String[] @default([])

  // Soft-archive, mirroring Owner. Residents carry messages, documents,
  // signature requests and an activity log that must survive a move-out.
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents     ResidentDocument[]
  signatures    SignatureRequest[]
  meetings      MeetingAttendee[]
  tasks         Task[]
  messages      Message[]
  activityLog   ResidentActivity[]
  tickets       SupportTicket[]
  voteResponses VoteResponse[]

  @@index([apartmentId])
  @@index([signatureStatus])
  @@map("residents")
  invitations ResidentInvitation[]
}

/// A personal invitation into the resident portal.
///
/// ── WHY THIS EXISTS ─────────────────────────────────────────────────────────
///
/// A phone number is not an identity. It is not unique across tenants, people
/// share numbers, and numbers are recycled — so "the OTP succeeded" answers
/// only "this person controls this handset", never "this person is entitled to
/// that resident's file". An audit found the previous login resolving a
/// resident with `findFirst({ where: { phone } })`, which handed out a session
/// for whichever row the planner reached first.
///
/// The invitation is the missing half: a credential the organisation issues to
/// a specific resident, naming the tenant, project, building and apartment up
/// front. OTP then proves the handset; the invitation says whose file it opens.
///
/// ── WHY THE IDS ARE DENORMALISED ────────────────────────────────────────────
///
/// `tenantId` … `apartmentId` could all be derived by walking
/// resident → apartment → building → complex → project. They are stored anyway
/// because this row is a CREDENTIAL: what it grants must be legible without
/// four joins, and must not silently change if the resident is later moved to a
/// different apartment. An invitation grants what it says, or it is rejected.
///
/// ── THE TOKEN ───────────────────────────────────────────────────────────────
///
/// Stored hashed, never in the clear. The plaintext exists only in the link
/// that was sent; a database read must not yield a working credential — the
/// same rule the signing OTP now follows.
model ResidentInvitation {
  id           String   @id @default(cuid())

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The scope this invitation grants, fixed at issue time.
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId   String
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartmentId  String
  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  /// HMAC of the token that was sent. The plaintext is never stored.
  tokenHash    String   @unique

  /// The phone the invitation was addressed to, so a leaked link cannot be
  /// redeemed from a different handset.
  phone        String

  expiresAt    DateTime
  /// Set on first successful redemption. An invitation opens a session once;
  /// afterwards the resident signs in with their phone.
  usedAt       DateTime?
  revokedAt    DateTime?
  revokedReason String?

  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, residentId])
  @@index([expiresAt])
  @@map("resident_invitations")
}

model ResidentActivity {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type       String   // call | meeting | message | status_change | document | signature | note
  title      String
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  createdById String?

  @@index([residentId])
  @@map("resident_activities")
}

// ============================================================
// SIGNATURES
// ============================================================

model SignatureRequest {
  id          String           @id @default(cuid())
  tenantId    String

  residentId  String
  resident    Resident         @relation(fields: [residentId], references: [id])

  documentId  String?
  document    Document?        @relation(fields: [documentId], references: [id])

  provider    SignatureProvider @default(DOCUSIGN)
  externalId  String?          // DocuSign envelope ID etc.

  status      SignatureStatus  @default(DRAFT)

  sentAt      DateTime?
  viewedAt    DateTime?
  signedAt    DateTime?
  rejectedAt  DateTime?
  expiresAt   DateTime?

  rejectionReason String?
  signatureImageUrl String?

  metadata    Json?   // provider-specific data

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([tenantId, status])
  @@map("signature_requests")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])

  category    DocumentCategory
  status      DocumentStatus   @default(DRAFT)

  title       String
  description String?
  fileName    String
  fileSize    Int              // bytes
  mimeType    String
  s3Key       String           // AWS S3 object key
  s3Bucket    String

  // ── Version control ──────────────────────────────────────────────────────
  //
  // CHAIN SHAPE: the FIRST upload is the root and keeps `parentId = null`.
  // Every later version points at that root, NOT at the version before it, so
  // the whole history is one query (`where: { parentId: rootId }`) instead of a
  // recursive walk, and no version can be orphaned by deleting a middle one.
  //
  // Each version has its OWN `s3Key`. A replacement never overwrites the
  // previous object — that is what makes the history real rather than a
  // counter, and it is why `remove()` deletes exactly one object.
  //
  // `createdById` + `createdAt` on each row are the per-version "who and when";
  // `AuditService` records the same facts independently.
  version     Int              @default(1)
  parentId    String?          // the ROOT of this version chain (null on the root itself)
  parent      Document?        @relation("DocumentVersions", fields: [parentId], references: [id])
  versions    Document[]       @relation("DocumentVersions")

  /**
   * Exactly one row per chain is true. Denormalised deliberately: the library
   * list and every project tab filter on it, and deriving "max(version) in my
   * chain" per row would turn a list query into a correlated subquery. It is
   * maintained only inside the transaction that adds or removes a version.
   */
  isLatest    Boolean          @default(true)

  // OCR & Search
  ocrText     String?          // extracted text for search
  ocrStatus   String           @default("pending") // pending | processing | done | failed
  language    Language         @default(he)

  // Access
  isPublic    Boolean          @default(false)
  tags        String[]         @default([])

  // Expiration
  expiresAt   DateTime?

  createdById String
  createdBy   User             @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  residentDocuments ResidentDocument[]
  signatureRequests SignatureRequest[]

  @@index([tenantId, category])
  @@index([tenantId, projectId])
  // The library and every project tab list only current documents.
  @@index([tenantId, isLatest])
  // Fetching one chain's history, newest first.
  @@index([parentId, version])
  @@map("documents")
}

model ResidentDocument {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  addedAt    DateTime @default(now())

  @@unique([residentId, documentId])
  @@map("resident_documents")
}

// ============================================================
// MEETINGS
// ============================================================

/// A scheduled meeting, its invitees, and their RSVPs.
///
/// Tenant boundary: `tenantId` is on the row, so meetings are scoped directly
/// rather than through the Complex/Building traversal that Building and
/// Apartment need. When `projectId` is set, the service additionally verifies
/// that the project belongs to the SAME tenant before writing — a meeting must
/// never be able to reference another tenant's project.
model Meeting {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  /// Who scheduled it. Nullable so an existing row (or a future automated
  /// scheduler with no human actor) is representable, but the API always sets
  /// it from the JWT.
  createdById String?
  createdBy   User?    @relation("MeetingCreator", fields: [createdById], references: [id])

  title       String
  description String?
  location    String?
  isVirtual   Boolean  @default(false)
  meetingUrl  String?

  startTime   DateTime
  endTime     DateTime?

  // AI summary
  aiSummary   String?
  aiSummaryGeneratedAt DateTime?

  notes       String?
  /// One of MEETING_STATUSES in
  /// services/api-gateway/src/meetings/meeting-constants.ts.
  status      String   @default("scheduled") // scheduled | completed | cancelled

  /// Cancellation is a state change, not a delete: attendees were already
  /// notified, and the record of "this was called off" is what makes the
  /// cancellation notification meaningful afterwards.
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   MeetingAttendee[]
  tasks       Task[]
  reminders   MeetingReminderDispatch[]

  @@index([tenantId, projectId])
  @@index([tenantId, startTime])
  /// The reminder scanner's query: WHERE status = 'scheduled' AND startTime BETWEEN …
  @@index([status, startTime])
  @@map("meetings")
}

/// Tokenised, resident-facing access to ONE meeting invitation.
///
/// Deliberately modelled on `SigningSession`, which is the established
/// precedent here for letting a non-User act on a record: a 48-byte url-safe
/// random token, an expiry, and explicit revocation. It is NOT a login and it
/// grants NOTHING beyond viewing and answering the single invitation it is
/// bound to — residents never become `User` rows.
///
/// Bound to a MeetingAttendee rather than to a Resident, so the token's
/// authority is exactly "this person, this meeting". The tenant is derived by
/// traversing attendee → meeting → tenantId; the token itself carries no
/// tenant claim that could be forged.
model MeetingAccessToken {
  id         String   @id @default(cuid())

  attendeeId String   @unique
  attendee   MeetingAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  token      String   @unique

  expiresAt  DateTime
  revokedAt  DateTime?

  /// Replay ceiling. A resident legitimately opens the link more than once
  /// (view, accept, later change their mind, confirm attendance), so the token
  /// is not single-use like a signing session's OTP. Instead every accepted
  /// action increments this and the token dies at MEETING_TOKEN_MAX_USES, which
  /// bounds what a leaked or replayed link can do.
  useCount   Int      @default(0)
  firstUsedAt DateTime?
  lastUsedAt  DateTime?

  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("meeting_access_tokens")
}

/// One row per (meeting, reminder offset) actually dispatched.
///
/// This table IS the de-duplication mechanism for Phase 5: the scanner writes
/// the row inside the same transaction that claims the reminder, and the unique
/// constraint means a second scheduler tick — or a second process — cannot send
/// the same reminder twice. Cheaper and far more honest than trying to infer
/// "did we already remind?" from the notification/message log.
model MeetingReminderDispatch {
  id            String   @id @default(cuid())
  meetingId     String
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Minutes before `Meeting.startTime` this reminder represents.
  offsetMinutes Int

  dispatchedAt  DateTime @default(now())
  /// How many recipients it actually reached, for observability.
  staffNotified    Int   @default(0)
  residentsQueued  Int   @default(0)

  @@unique([meetingId, offsetMinutes])
  @@map("meeting_reminder_dispatches")
}

model MeetingAttendee {
  id         String    @id @default(cuid())
  meetingId  String
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Either an internal user or a resident
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id])

  /// ATTENDANCE, recorded after the fact. Distinct from `rsvpStatus`, which is
  /// what the person SAID beforehand. Someone can accept and not turn up, and
  /// for a pinuy-binuy resident meeting the difference is the whole point of
  /// tracking it — quorum is about who was in the room.
  /// `null` means not yet recorded.
  attended   Boolean?

  role       String?   // organizer | attendee | guest

  /// One of RSVP_STATUSES in
  /// services/api-gateway/src/meetings/meeting-constants.ts.
  rsvpStatus  String   @default("pending") // pending | accepted | declined | tentative
  respondedAt DateTime?
  invitedAt   DateTime @default(now())

  /// How the RSVP arrived: `staff` (a User answering in the CRM) or `token`
  /// (a Resident answering through their invitation link). Recorded because
  /// the two carry different evidential weight.
  respondedVia String?

  /// Resident-facing invitation link, when this attendee is a Resident.
  accessToken MeetingAccessToken?

  /// NOTE on the two unique constraints: both columns are nullable, and
  /// PostgreSQL treats NULLs as distinct in a unique index. So these prevent
  /// inviting the same USER twice and the same RESIDENT twice, and do NOT
  /// collapse the many rows that have a null in the other column. That is the
  /// intended behaviour; the service also rejects an attendee row that names
  /// neither a user nor a resident, which the database cannot express here.
  @@unique([meetingId, userId])
  @@unique([meetingId, residentId])
  @@index([meetingId, rsvpStatus])
  @@map("meeting_attendees")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id          String       @id @default(cuid())
  tenantId    String

  type        TaskType     @default(GENERAL)
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)

  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id])

  dueDate     DateTime?
  completedAt DateTime?

  // Context associations
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id])
  meetingId   String?
  meeting     Meeting?  @relation(fields: [meetingId], references: [id])

  // Dependencies
  blockedById String?
  blockedBy   Task?    @relation("TaskDependencies", fields: [blockedById], references: [id])
  blocking    Task[]   @relation("TaskDependencies")

  tags        String[] @default([])
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assigneeId, status])
  @@index([tenantId, projectId])
  @@map("tasks")
}

// ============================================================
// COMMUNICATIONS
// ============================================================

model Message {
  id          String                 @id @default(cuid())
  tenantId    String

  channel     MessageChannel
  direction   CommunicationDirection
  status      MessageStatus          @default(QUEUED)

  // Recipient
  residentId  String?
  resident    Resident?              @relation(fields: [residentId], references: [id])
  toPhone     String?
  toEmail     String?

  subject     String?                // email subject
  body        String
  templateId  String?
  template    CommunicationTemplate? @relation(fields: [templateId], references: [id])

  /**
   * The automation that produced this message, if any. Null for a message a
   * person sent by hand.
   *
   * This is what makes a per-automation send cap DURABLE: the count comes from
   * rows already written, so a restart, a redeploy, or a Redis flush cannot
   * reset the window and let an automation exceed its cap.
   */
  automationId String?
  automation   Automation? @relation(fields: [automationId], references: [id])

  // Tracking
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt      DateTime?
  cancelledAt   DateTime?
  /// Sanitised. Provider payloads are scrubbed before they land here — see
  /// `sanitiseProviderDetail` in services/api-gateway/src/messaging/sanitise.ts.
  failureReason String?

  // ── Dispatch bookkeeping (Phases 1–2) ────────────────────────────────
  /// How many provider calls have been made. Incremented on CLAIM, not on
  /// success, so a worker that dies mid-call still consumes an attempt and a
  /// permanently broken recipient cannot be retried forever.
  attemptCount  Int       @default(0)
  /// Per-message cap. Defaulted from MESSAGE_MAX_ATTEMPTS at enqueue time so
  /// changing the env var does not retroactively resurrect dead messages.
  maxAttempts   Int       @default(5)
  lastAttemptAt DateTime?
  /// Earliest time a worker may claim this row. Set to now() at enqueue and to
  /// an exponential-backoff point after each retryable failure.
  nextAttemptAt DateTime?
  /// Which provider implementation handled it, e.g. `twilio`, `dev-noop`.
  providerName      String?
  /// The provider's own id for the message, used to correlate delivery
  /// webhooks. Distinct from `externalId`, which predates the dispatcher and
  /// is the legacy inbound-correlation column.
  providerMessageId String?
  /// TRUE when no external message left the building — the dev/no-op provider
  /// recorded what WOULD have been sent. Surfaced in the CRM so a simulated
  /// send can never be mistaken for a real one.
  isSimulated   Boolean   @default(false)
  /// Caller-supplied de-duplication key, unique per tenant. Reminders and
  /// invitations use it so a retry or a double scheduler tick cannot produce a
  /// second message to the same person about the same thing.
  idempotencyKey String?

  // External IDs
  externalId  String?  // WhatsApp message ID, SES message ID etc.

  metadata    Json?

  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, residentId])
  @@index([tenantId, channel, status])
  // Per-automation send caps count rows inside a rolling time window.
  @@index([automationId, createdAt])
  /// The worker's claim query: WHERE status IN (QUEUED) AND nextAttemptAt <= now().
  @@index([status, nextAttemptAt])
  @@map("messages")
}

model CommunicationTemplate {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  channel    MessageChannel
  language   Language       @default(he)

  subject    String?        // email
  body       String         // supports {{variable}} syntax
  variables  String[]       @default([])  // list of supported vars

  isActive   Boolean        @default(true)
  isApproved Boolean        @default(false)  // WhatsApp templates need approval

  // WhatsApp-specific
  waTemplateName String?
  waCategory     String?    // MARKETING | UTILITY | AUTHENTICATION

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   Message[]

  @@unique([tenantId, name, channel, language])
  @@map("communication_templates")
}

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  name        String
  description String?
  channel     MessageChannel
  status      String   @default("draft") // draft | scheduled | running | completed | cancelled

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Stats (denormalized for fast reads)
  totalRecipients Int @default(0)
  sent            Int @default(0)
  delivered       Int @default(0)
  read            Int @default(0)
  failed          Int @default(0)

  templateId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  leads       Lead[]

  @@index([tenantId, status])
  @@map("campaigns")
}

// ============================================================
// SUPPORT TICKETS
