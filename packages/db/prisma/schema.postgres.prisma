// ============================================================
// EXCEL IMPORT (Run 3)
// Bulk ingest of owners/residents from a spreadsheet. The import
// does NOT own any business rules — it maps a sheet onto the same
// services manual CRUD uses (OwnershipService, NationalIdService,
// TenantScopeService). These tables record only WHAT was attempted
// and WHAT the outcome was, for the report and the history view.
// ============================================================

enum ImportEntityType {
  OWNER
  RESIDENT
}

enum ImportMode {
  ADD_ONLY        // create new records; anything matching an existing one is skipped
  UPDATE_ONLY     // update matched records; unmatched rows are skipped
  ADD_AND_UPDATE  // upsert
}

enum ImportJobStatus {
  UPLOADED     // file stored + parsed, awaiting column mapping
  MAPPED       // mapping confirmed, awaiting validation/preview
  PREVIEWED    // validated, awaiting user confirmation
  IMPORTING    // transaction in flight
  COMPLETED    // committed (may still carry per-row failures that were skipped)
  FAILED       // rolled back — nothing was written
  CANCELLED    // user abandoned before committing
}

/**
 * `ImportRowIssue.severity`. WARNING rows still import; ERROR rows never do.
 */
enum ImportIssueSeverity {
  ERROR
  WARNING
}

/** What the preview decided would happen to a row. */
enum ImportRowOutcome {
  CREATE
  UPDATE
  SKIP_DUPLICATE
  SKIP_MODE       // valid, but the chosen ImportMode excludes it
  INVALID
  NEEDS_REVIEW    // ambiguous duplicate match — never auto-merged
}

model ImportJob {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Tenancy of the imported rows is inherited through this project, exactly as
  // Complex/Building/Apartment inherit theirs. Every apartment referenced by a
  // row must resolve INSIDE this project.
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  entityType  ImportEntityType @default(OWNER)
  mode        ImportMode       @default(ADD_AND_UPDATE)
  status      ImportJobStatus  @default(UPLOADED)

  fileName    String
  fileSize    Int
  /** MinIO object key for the uploaded workbook. Never returned to a client. */
  storageKey  String?
  sheetName   String?

  /**
   * The confirmed column mapping: `{ "<field>": { "column": "שם בעלים",
   * "index": 0, "confidence": 1, "source": "USER" } }`. Persisted so a later
   * reader can tell exactly how the sheet was interpreted, and so a repeat
   * import of the same template can reuse it.
   */
  columnMapping Json?
  /** Header row exactly as read from the sheet, for the report. */
  sheetHeaders  String[] @default([])

  totalRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  failedRows  Int @default(0)

  /** Aggregated `{ code, count, message }[]` — never any row values. */
  errorSummary Json?
  /** Populated only for FAILED: why the whole transaction rolled back. */
  failureReason String?

  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues      ImportRowIssue[]
  decisions   ImportRowDecision[]

  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, status])
  @@map("import_jobs")
}

/** What the user chose for one ambiguous row. There is no MERGE option. */
enum ImportDecisionAction {
  UPDATE_EXISTING // apply the sheet row to the chosen existing record
  CREATE_NEW      // the sheet row is a different person; create a new record
  SKIP            // leave both alone
}

/**
 * A human's per-row ruling on an ambiguous duplicate.
 *
 * WHY A SEPARATE TABLE FROM ImportRowIssue
 * ----------------------------------------
 * `ImportsService.persistIssues` DELETES and recreates every `ImportRowIssue`
 * for the job on each preview, because issues are derived from a fresh
 * re-validation against live data. Decisions are the opposite kind of fact:
 * they are user input, entered once, and must survive every subsequent
 * re-validation — storing them alongside issues would wipe them the moment the
 * user previewed again.
 *
 * A decision is ADVICE, not authority. It is re-checked at commit against the
 * candidate set as it stands at that moment: if the record the user chose is no
 * longer one of the row's candidates (someone deleted or edited it in the
 * meantime) the row fails rather than writing to a stale target. Nothing here
 * can cause an automatic merge — UPDATE_EXISTING applies the sheet row to ONE
 * explicitly named record, and the two records are never combined.
 *
 * Tenancy is inherited through `job`, which is itself tenant-scoped; every
 * service method resolves the job inside the caller's tenant first, so a
 * decision can only ever be written against a job the caller can already see.
 */
model ImportRowDecision {
  id          String   @id @default(cuid())
  jobId       String
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /** 1-based row number AS SEEN IN EXCEL, header included. */
  rowNumber   Int
  action      ImportDecisionAction

  /**
   * The existing Owner/Resident the user picked. Required for UPDATE_EXISTING,
   * null otherwise. Validated against the row's LIVE candidate list on use, so
   * an id from another tenant or another row is refused.
   */
  targetEntityId String?

  /** Free-text justification, optional. Never contains sheet values. */
  note        String?

  decidedById String
  decidedBy   User     @relation("ImportRowDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One ruling per row. Re-deciding a row overwrites the previous ruling
  // (upsert) rather than accumulating conflicting instructions.
  @@unique([jobId, rowNumber])
  @@index([jobId])
  @@map("import_row_decisions")
}

/**
 * Per-row detail behind the downloadable error report.
 *
 * `currentValue` is the offending cell as it appeared in the sheet — EXCEPT for
 * a national ID column, where the import writes a mask (`***1234`) instead.
 * A full תעודת זהות must never reach this table: the report is downloadable and
 * the history view renders these rows verbatim.
 */
model ImportRowIssue {
  id          String   @id @default(cuid())
  jobId       String
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /** 1-based row number AS SEEN IN EXCEL, header included. */
  rowNumber   Int
  outcome     ImportRowOutcome
  severity    ImportIssueSeverity @default(ERROR)

  /** Mapped field name, e.g. `phone`. Null for whole-row issues. */
  field       String?
  /** Sheet column header the field came from. */
  column      String?
  code        String
  message     String
  /** Masked where the column holds PII. */
  currentValue String?
  /** Hebrew, actionable: "כתבו 1/3 במקום 33.33%". */
  suggestion  String?

  /** Existing record this row matched, when the issue is a duplicate. */
  matchedEntityId String?
  /** Why it matched: NATIONAL_ID | OWNER_ID | PHONE | NAME_AND_APARTMENT. */
  matchReason     String?

  createdAt   DateTime @default(now())

  @@index([jobId, rowNumber])
  @@index([jobId, severity])
  @@map("import_row_issues")
}

// ============================================================
// CMS — the OpenDoor Site Manager
// ============================================================
//
// What the PUBLIC website says, and the record of who said it.
//
// ── WHY THESE TABLES AND NOT A JSON BLOB PER PAGE ──────────────────────────
//
// Identity, tenant, publication state, revision, authorship and verification
// are all things the product has to QUERY and ENFORCE, not merely store:
// "which items are awaiting review", "who published this and when", "is this
// figure still verified after the edit". A JSON document per page can hold
// those facts but cannot be asked about them, and cannot be constrained.
//
// So every one of them is an explicit, indexed column here, and the free-form
// part — the block tree an editor actually authors — is the ONLY thing left as
// JSON.
//
// ── THE FOUR-TABLE SPLIT ───────────────────────────────────────────────────
//
//   CmsContent      the item, its identity and its CURRENT working draft
//   CmsRevision     an append-only full SNAPSHOT per save
//   CmsPublication  an immutable snapshot of what the public was actually given
//   CmsVerification per-field provenance, with its own append-only audit
//
// Draft, revision and publication are deliberately three different things.
// Editing a page must not change what the website is serving; publishing must
// freeze exactly what was approved rather than re-read a draft that may have
// moved on; and restoring history must not rewrite it. One table could not
// hold all three without one of those guarantees quietly failing.
//
// ── TENANCY ────────────────────────────────────────────────────────────────
//
// Every table carries `tenantId` and every index leads with it. Uniqueness is
// tenant-scoped — two tenants may both own the page `transparency` — and no
// query in the CMS is written without it. `tenantId` is never accepted from
// the browser; it comes from the authenticated server context.

enum CmsContentKind {
  PAGE
  PROJECT
  ARTICLE
  FAQ_ITEM
  NAVIGATION
  SETTINGS
}

enum CmsPublicationState {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CmsRevisionReason {
  SAVE
  PUBLISH
  UNPUBLISH
  RESTORE
}

/// Mirrors `VerificationStatus` in @urban-renewal/api-contracts. The contract
/// DERIVES this value from the record; this column stores what was derived, so
/// "everything awaiting a second review" is one indexed query.
enum CmsVerificationStatus {
  UNVERIFIED
  VERIFIED
  SELF_VERIFIED
  SECOND_REVIEW_REQUIRED
}

enum CmsVerificationEvent {
  EDITED
  VERIFIED
  INVALIDATED
  REVIEW_REQUESTED
}

/// How far a piece of content may travel. FEASIBILITY is distinct from
/// INTERNAL on purpose: an internal figure may one day be verified and
/// published, a feasibility scenario output may not, ever.
enum CmsExposureLevel {
  PUBLIC
  INTERNAL
  FEASIBILITY
}

/// What an image is claimed to BE. Publishing an editorial photograph as
/// though it depicted an OpenDoor project is the specific failure this exists
/// to make impossible, so it is a column and not a caption convention.
enum CmsImageClaim {
  VERIFIED_PROJECT_PHOTO
  EDITORIAL_CONTEXT
  ARCHITECTURAL_PATTERN
}

model CmsContent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind CmsContentKind
  /// Stable, human-meaningful address within its kind. Tenant-scoped, so two
  /// tenants may each own `transparency` without colliding.
  slug String

  state    CmsPublicationState @default(DRAFT)
  exposure CmsExposureLevel    @default(PUBLIC)

  /**
   * The working draft: the block tree as the editor currently has it.
   *
   * JSON because this is the one genuinely open-ended part of the model — the
   * shape differs per block type and the set of block types grows. It is
   * validated against the api-contracts schema at the gateway before it is
   * written, so "unvalidated JSON" it is not; it is simply not a shape SQL can
   * usefully constrain.
   *
   * This is NOT what the website serves. The public reads CmsPublication.
   */
  draft Json

  /// Per-locale SEO. Absent locales fall back to the page's own heading and
  /// opening sentence, which is why this is nullable rather than defaulted.
  seo Json?

  /// The newest revision, denormalised so the editor can show "last saved"
  /// without an aggregate over the whole revision history on every load.
  currentRevisionId String?      @unique
  currentRevision   CmsRevision? @relation("CmsContentCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  /// The publication the website is serving right now, or null if this item has
  /// never been published or has been withdrawn. The resolver reads THIS, so an
  /// unpublished edit cannot reach the public by any path.
  livePublicationId String?         @unique
  livePublication   CmsPublication? @relation("CmsContentLivePublication", fields: [livePublicationId], references: [id], onDelete: SetNull)

  createdAt        DateTime  @default(now())
  createdById      String
  createdBy        User      @relation("CmsContentCreator", fields: [createdById], references: [id])
  updatedAt        DateTime  @updatedAt
  updatedById      String
  updatedBy        User      @relation("CmsContentEditor", fields: [updatedById], references: [id])
  firstPublishedAt DateTime?

  revisions     CmsRevision[]          @relation("CmsContentRevisions")
  publications  CmsPublication[]       @relation("CmsContentPublications")
  verifications CmsVerification[]
  mediaRefs     CmsMediaReference[]
  auditEntries  CmsVerificationAudit[]

  @@unique([tenantId, kind, slug])
  @@index([tenantId, kind, state])
  @@index([tenantId, state, updatedAt])
  @@map("cms_content")
}

/**
 * One append-only FULL snapshot per save.
 *
 * Full, not a diff: restoring must not depend on replaying every intermediate
 * step correctly, and a snapshot that can be read on its own is one that can be
 * audited on its own. Storage is cheap next to the cost of a history that
 * cannot be trusted.
 *
 * Restoring an old revision writes a NEW revision whose snapshot happens to
 * equal the old one, with `restoredFromRevisionId` recording where it came
 * from. History is therefore only ever appended to, never rewound: what the
 * page said last Tuesday remains true even after somebody undoes it.
 */
model CmsRevision {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentId String
  content   CmsContent @relation("CmsContentRevisions", fields: [contentId], references: [id], onDelete: Cascade)

  /// Monotonic per item, starting at 1. Gives the history a stable order that
  /// does not depend on timestamp resolution or clock skew.
  sequence Int
  reason   CmsRevisionReason

  snapshot Json
  seo      Json?
  /// The publication state at the moment of the save, so the history explains
  /// itself without joining forward to what happened later.
  stateAtRevision CmsPublicationState

  authorId  String
  author    User     @relation("CmsRevisionAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  restoredFromRevisionId String?
  restoredFrom           CmsRevision?  @relation("CmsRevisionRestoredFrom", fields: [restoredFromRevisionId], references: [id], onDelete: SetNull)
  restoredInto           CmsRevision[] @relation("CmsRevisionRestoredFrom")

  /// Optional one-line note from the editor. Never required: a mandatory
  /// message field produces "update" on every row and buys nothing.
  summary String?

  currentFor   CmsContent?      @relation("CmsContentCurrentRevision")
  publications CmsPublication[] @relation("CmsPublicationRevision")

  @@unique([contentId, sequence])
  @@index([tenantId, contentId, createdAt])
  @@map("cms_revisions")
}

/**
 * What the public was actually given, frozen.
 *
 * Rows here are written once and never updated. Withdrawing a publication sets
 * `unpublishedAt` and clears the item's `livePublicationId`; it does not delete
 * or edit the row, because "what did the website say on the day the resident
 * signed" has to remain answerable.
 *
 * The snapshot is stored again rather than reached through the revision, even
 * though `revisionId` records which revision it came from. Publication is a
 * PROJECTION of a revision, not a copy of it: internal fields are dropped,
 * verifier identity and source vocabulary are stripped, and unverified claims
 * are omitted. Storing the projection is what makes it possible to prove later
 * what was and was not exposed.
 */
model CmsPublication {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentId String
  content   CmsContent @relation("CmsContentPublications", fields: [contentId], references: [id], onDelete: Cascade)

  revisionId String
  revision   CmsRevision @relation("CmsPublicationRevision", fields: [revisionId], references: [id])

  /// The public-safe projection, exactly as served. Never the raw draft.
  snapshot Json
  seo      Json?

  publishedAt   DateTime  @default(now())
  publishedById String
  publishedBy   User      @relation("CmsPublicationPublisher", fields: [publishedById], references: [id])
  unpublishedAt DateTime?

  liveFor CmsContent? @relation("CmsContentLivePublication")

  @@index([tenantId, contentId, publishedAt])
  @@map("cms_publications")
}

/**
 * Provenance for one field of one item.
 *
 * `verifiedValue` is stored ALONGSIDE the live value so that invalidation is a
 * mechanism rather than an intention: when the two differ the fact is no longer
 * verified, and nobody has to remember to clear a flag. That is the whole
 * design. A boolean `isVerified` would survive an edit and quietly lie.
 */
model CmsVerification {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentId String
  content   CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// Dotted path into the item, e.g. `unitCount` or `milestone.2.title`.
  field String

  value         Json
  verifiedValue Json?
  status        CmsVerificationStatus @default(UNVERIFIED)

  editedById String
  editedBy   User     @relation("CmsVerificationEditor", fields: [editedById], references: [id])
  editedAt   DateTime @default(now())

  verifiedById String?
  verifiedBy   User?     @relation("CmsVerificationVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  /// Where the claim comes from, and the reference within it. Both are INTERNAL
  /// and are stripped from every public projection, along with verifier
  /// identity: the public learns that a figure was verified, never by whom.
  source          String?
  sourceReference String?

  auditEntries CmsVerificationAudit[]

  @@unique([contentId, field])
  @@index([tenantId, status])
  @@map("cms_verifications")
}

/// Append-only. Rows are never updated or deleted, which is what separates an
/// audit trail from a status column that happens to have a timestamp.
model CmsVerificationAudit {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentId String
  content   CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  verificationId String?
  verification   CmsVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  field  String
  event  CmsVerificationEvent
  status CmsVerificationStatus

  actorId    String
  actor      User     @relation("CmsVerificationAuditActor", fields: [actorId], references: [id])
  occurredAt DateTime @default(now())

  /// Human-readable LABELS, not the values themselves. The audit trail has to be
  /// readable by someone who lacks permission to see every figure it mentions.
  previousValueLabel String?
  newValueLabel      String?

  source          String?
  sourceReference String?
  note            String?

  @@index([tenantId, contentId, occurredAt])
  @@index([tenantId, field, event])
  @@map("cms_verification_audit")
}

/**
 * A content item's reference to a stored image.
 *
 * This is deliberately NOT a media library: it records which objects a piece of
 * content points at, so that publishing, revision history and deletion can all
 * reason about images without inventing an upload pipeline. The bytes stay
 * where they already are, behind the existing StorageService abstraction, and
 * `storageKey` is the same tenant-scoped key that service already issues.
 *
 * `classification` and `alt` are NOT NULL because an image lacking either is
 * one that cannot be published, and the cheapest place to guarantee that is
 * here rather than in every screen that touches an image.
 */
model CmsMediaReference {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentId String
  content   CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// Where inside the item this image is used, e.g. `hero` or `gallery.1`.
  field String

  storageKey String
  filename   String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?

  classification CmsImageClaim

  /// LocalizedContent: `{ he, en? }`. Hebrew is required, English never blocks.
  alt     Json
  caption Json?
  credit  String?
  takenOn DateTime?
  /// `{ x, y }` in 0..1, for art-directed cropping.
  focalPoint Json?

  uploadedById String
  uploadedBy   User     @relation("CmsMediaUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@unique([contentId, field, storageKey])
  @@index([tenantId, classification])
  @@map("cms_media_references")
}
