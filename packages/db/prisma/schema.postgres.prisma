model SignatureRecord {
  id          String   @id @default(cuid())
  tenantId    String
  packageId   String
  package     SignaturePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id])
  apartmentId String

  method      String   @default("DIGITAL") // DIGITAL | WET
  status      String   @default("PENDING") // PENDING | SIGNED | REFUSED | REVOKED

  signerRole    String   @default("OWNER")
  required      Boolean  @default(true)
