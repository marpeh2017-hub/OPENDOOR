/// Immutable reproducibility record. Structured inputs stay in their own
/// tables; JSON here freezes the exact input/output state behind a result.
model FeasibilityCalculationSnapshot {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile  @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  scenarioId         String
  scenario           FeasibilityScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  engineVersion      String
  inputSnapshot      Json
  outputSnapshot     Json
  validationSnapshot Json
  /// Optional user-selected sensitivity matrix frozen with this calculation.
  /// It is report evidence only, never an editable scenario input.
  sensitivitySnapshot Json?
  createdById        String
  createdAt          DateTime            @default(now())
  reportVersion      FeasibilityReportVersion?

  @@index([tenantId, feasibilityProfileId, scenarioId, createdAt])
  @@map("feasibility_calculation_snapshots")
}

model FeasibilityReportVersion {
  id                 String                   @id @default(cuid())
  tenantId           String
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feasibilityProfileId String
