// ============================================================
// AUTOMATION ENGINE
// ============================================================

model Automation {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])

  name        String
  description String?
  isActive    Boolean           @default(true)

  trigger     AutomationTrigger
  triggerConfig Json            @default("{}")  // filter conditions

  actions     AutomationAction[]
  messages    Message[]

  /**
   * DRY RUN — the safety default for automations that contact residents.
   *
   * True means the runner evaluates the automation completely and RECORDS what
   * it would have sent (recipient, channel, rendered body) without dispatching
   * anything. Any automation containing a SEND_* action is forced back to dry
   * run whenever it is activated; taking it live is a separate, explicit,
   * admin-only act. A message cannot be recalled, so the reversible state is
   * the default state.
   */
  dryRun      Boolean @default(true)

  /**
   * Per-automation send caps. Null means "no cap of this kind".
   *
   * Counted against `Message` rows this automation actually produced, so a
   * restart cannot reset the window. The runner REFUSES to send past the cap
   * rather than queueing beyond it: an automation that silently accumulates a
   * backlog of unsent resident messages is worse than one that stops and says
   * so.
   */
  sendCapPerHour Int?
  sendCapPerDay  Int?

  // Stats
  runCount    Int @default(0)
  lastRunAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, trigger, isActive])
  @@map("automations")
}

model AutomationAction {
  id           String              @id @default(cuid())
  automationId String
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)

  order        Int
  type         AutomationActionType
  config       Json                // action-specific config
  delayMinutes Int                 @default(0)

  @@index([automationId])
  @@map("automation_actions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

/// In-app notification addressed to exactly ONE user.
///
/// `tenantId` is stored explicitly even though it is derivable from
/// `user.tenantId`. Two reasons, both practical rather than theoretical: every
/// list query filters by tenant AND user, and a stored column lets that be one
/// index instead of a join; and it makes the tenant boundary an invariant of
/// the row rather than of the code that happens to have written it, so a future
/// writer that forgets the join cannot silently create a cross-tenant row.
/// `NotificationsService` asserts the two agree before it ever writes.
model Notification {
  id       String   @id @default(cuid())

  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String
  /// One of NOTIFICATION_KINDS in
  /// services/api-gateway/src/notifications/notification-kinds.ts — kept as a
  /// String rather than a Prisma enum so a new emitting module does not need a
  /// migration, but validated on write against that list, so it is not free-form.
  type     String
  link     String?  // deep link in app

  /// What this notification is ABOUT, when it is about a record.
  /// `link` is where the user goes; these two are what the row concerns, which
  /// is what lets an emitter find or supersede its own earlier notifications
  /// (e.g. cancelling a meeting after it was already announced).
  entityType String?
  entityId   String?

  isRead   Boolean  @default(false)
  readAt   DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

// ============================================================
// REPORTING
// ============================================================

model SavedReport {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  name      String
  type      String   // project | signature | resident | team_performance | lead_sources | risk | financial
  config    Json     // filters, date ranges, grouping
  schedule  Json?    // cron schedule for auto-generation

  lastGeneratedAt DateTime?
  lastOutputUrl   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("saved_reports")
}

// ============================================================
// DIGITAL ZERO REPORT / FEASIBILITY FOUNDATION
// ============================================================

/// One professional feasibility profile per CRM project. Existing CRM project
/// fields remain operational facts; feasibility-specific dates, purpose and
/// professional metadata are intentionally kept here.
model FeasibilityProfile {
  id            String                   @id @default(cuid())
  tenantId      String
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String                   @unique
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  projectType   FeasibilityProjectType
  reportType    FeasibilityReportType    @default(ZERO_REPORT)
  status        FeasibilityProfileStatus @default(DRAFT)
  purpose       String
  valuationDate DateTime
  reportDate    DateTime
  clientName    String?
  developerName String?
  appraiserName String?
  neighborhood  String?

  createdById   String
  updatedById   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  parcels       GushChelkaRecord[]
  sources       FeasibilitySource[]
  assumptions   FeasibilityAssumption[]
  areas         FeasibilityAreaLine[]
  planningRights PlanningRight[]
  comparableTransactions ComparableTransaction[]
  scenarios     FeasibilityScenario[]
  calculationSnapshots FeasibilityCalculationSnapshot[]
  reportVersions FeasibilityReportVersion[]

  @@index([tenantId, status])
  @@map("feasibility_profiles")
}

/// A project may combine several block/parcel/sub-parcel records into one
/// renewal complex. They are deliberately not fields on Project.
model GushChelkaRecord {
  id                 String             @id @default(cuid())
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  gush               String
  chelka             String
  subChelka          String?
  landAreaSqm        Decimal?           @db.Decimal(18, 4)
  address            String?
  notes              String?
  classification     FeasibilityDataClassification @default(FACT)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean            @default(false)
  sourceId           String?
  sourceDate         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([feasibilityProfileId, gush, chelka, subChelka])
  @@index([feasibilityProfileId])
  @@map("gush_chelka_records")
}

model FeasibilitySource {
  id                 String             @id @default(cuid())
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  type               FeasibilitySourceType
  title              String
  issuer             String?
  sourceDate         DateTime?
  documentId         String?
  sourceUrl          String?
  pageReference      String?
  extractedValue     String?
  notes              String?
  reliability        FeasibilityConfidence @default(UNKNOWN)
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([feasibilityProfileId, type])
  @@index([feasibilityProfileId, documentId])
  @@map("feasibility_sources")
}

/// A market transaction used as explicit evidence for a comparison-method
/// valuation. Adjustment factors are stored separately, so an appraiser can
/// trace every movement from the observed transaction to the adjusted rate.
model ComparableTransaction {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  address            String
  transactionDate    DateTime
  transactionPrice   Decimal            @db.Decimal(18, 2)
  saleableAreaSqm    Decimal            @db.Decimal(18, 4)
  rooms              Decimal?           @db.Decimal(5, 2)
  floor              Int?
  buildingAgeYears   Int?
  condition          String?
  hasParking         Boolean            @default(false)
  balconyAreaSqm     Decimal?           @db.Decimal(18, 4)
  storageAreaSqm     Decimal?           @db.Decimal(18, 4)
  sourceId           String?
  sourceUrl          String?
  reliability        FeasibilityConfidence @default(UNKNOWN)
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  adjustments        ComparableAdjustment[]

  @@index([tenantId, feasibilityProfileId, transactionDate])
  @@index([feasibilityProfileId, sourceId])
  @@map("comparable_transactions")
}

/// Multiplicative adjustment: e.g. 1.03 means +3%, 0.97 means −3%.
/// A factor must be positive; the service rejects zero and negative values.
model ComparableAdjustment {
  id                    String                @id @default(cuid())
  comparableTransactionId String
  comparableTransaction  ComparableTransaction @relation(fields: [comparableTransactionId], references: [id], onDelete: Cascade)
  category              String
  factor                Decimal               @db.Decimal(12, 8)
  description           String?
  classification        FeasibilityDataClassification @default(ASSUMPTION)
  confidence            FeasibilityConfidence @default(UNKNOWN)
  sourceId              String?
  sourceDate            DateTime?
  createdById           String
  updatedById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([comparableTransactionId, category])
  @@index([comparableTransactionId])
  @@map("comparable_adjustments")
}

model FeasibilityAssumption {
  id                 String             @id @default(cuid())
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  key                String
  label              String
  value              Decimal?           @db.Decimal(24, 8)
  textValue          String?
  unit               String?
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean            @default(false)
  sourceId           String?
  sourceDate         DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  impact             String?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([feasibilityProfileId, key])
  @@index([feasibilityProfileId, classification])
  @@map("feasibility_assumptions")
}

/// A distinct area line makes the area used by every later calculation
/// explicit. Values are Decimal sqm, never generic Float `area` fields.
/// A regulatory or standard threshold, versioned by the date it takes effect.
///
/// WHY THIS EXISTS. Thresholds used to live only as per-profile assumptions,
/// which meant every project re-typed the VAT rate, the betterment levy or the
/// required developer margin, and nothing recorded which version of a rule a
/// given report relied on. When a rate changes, old reports must keep being
/// read against the rule that applied on their determining date — not against
/// today's. A registry keyed on `effectiveFrom` is what makes that possible.
///
/// RESOLUTION IS BY THE PROFILE'S `valuationDate` (the מועד קובע), which the
/// engine already treats as the determining date elsewhere.
///
/// `sourceReference` is required, not optional: a threshold nobody can cite is
/// not a regulatory rule, it is a guess with a number attached.
model FeasibilityRule {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Stable identifier the engine looks a rule up by, e.g. `vat-rate`.
  /// Deliberately the same vocabulary as `FeasibilityAssumption.key`, so a
  /// project-level assumption can be recognised as an override of a rule.
  code            String
  name            String
  authority       FeasibilityRuleAuthority
  /// Null means the rule applies everywhere; otherwise the municipality or
  /// district it is limited to. A local parking standard must not silently
  /// apply to a project in another city.
  jurisdiction    String?

  numericValue    Decimal?                 @db.Decimal(18, 6)
  textValue       String?
  unit            String?

  /// The window the rule governs. `effectiveUntil` null means "still in force".
  effectiveFrom   DateTime
  effectiveUntil  DateTime?

  sourceReference String
  sourceUrl       String?
  notes           String?
  isActive        Boolean                  @default(true)

  createdById     String
  updatedById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([tenantId, code, effectiveFrom])
  @@map("feasibility_rules")
}

model FeasibilityAreaLine {
  id                 String             @id @default(cuid())
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  areaType           FeasibilityAreaType
  label              String?
  valueSqm           Decimal             @db.Decimal(18, 4)
  classification     FeasibilityDataClassification @default(FACT)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean            @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([feasibilityProfileId, areaType])
  @@map("feasibility_area_lines")
}

/// Existing, approved, proposed and uncertain planning rights must be line
/// items so the calculation engine can reject an inappropriate Base scenario.
model PlanningRight {
  id                 String             @id @default(cuid())
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  category           String
  status             PlanningRightStatus
  areaSqm            Decimal?           @db.Decimal(18, 4)
  unitCount          Int?
  floorLimit         Int?
  heightMeters       Decimal?           @db.Decimal(10, 2)
  planNumber         String?
  landUse            String?
  classification     FeasibilityDataClassification @default(SOURCE_DATA)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean            @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([feasibilityProfileId, status])
  @@map("planning_rights")
}

/// An independently editable planning/economic scenario. Inputs and outputs
/// for one scenario must never mutate another scenario or the base source data.
model FeasibilityScenario {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feasibilityProfileId String
  feasibilityProfile FeasibilityProfile     @relation(fields: [feasibilityProfileId], references: [id], onDelete: Cascade)
  name               String
  kind               FeasibilityScenarioKind @default(CUSTOM)
  description        String?
  probability        Decimal?               @db.Decimal(7, 6)
  isBaseline         Boolean                @default(false)
  /// Market value of NON-CASH consideration given for the land — typically
  /// finished apartments handed to the seller in a combination deal.
  ///
  /// It is not a cash-flow line and must never become one: no money moves, so
  /// nothing is drawn, financed or repaid against it. What it does is enter
  /// the RATIO denominators, because a developer who gives away twenty
  /// million shekels of flats has paid twenty million for the land whether or
  /// not a shekel crossed an account.
  ///
  /// Null and zero mean the same thing here and both reduce every derived
  /// figure to its cash-only form exactly.
  considerationInKind Decimal?              @db.Decimal(18, 2)
  version            Int                    @default(1)
  createdById        String
  updatedById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  unitMix            FeasibilityUnitMixLine[]
  revenueLines       FeasibilityRevenueLine[]
  costLines          FeasibilityCostLine[]
  financing          FeasibilityFinancingAssumption?
  timelinePhases     FeasibilityTimelinePhase[]
  cashFlowAllocations FeasibilityCashFlowAllocation[]
  equityTranches      FeasibilityEquityTranche[]
  compensations      FeasibilityCompensationLine[]
  calculationSnapshots FeasibilityCalculationSnapshot[]

  @@unique([feasibilityProfileId, name])
  @@index([tenantId, feasibilityProfileId])
  @@index([feasibilityProfileId, kind])
  @@map("feasibility_scenarios")
}

/// Proposed product mix for a scenario. Each area field is explicit so later
/// revenue and construction-cost engines cannot accidentally use one generic
/// sqm value for incompatible calculations.
model FeasibilityUnitMixLine {
  id                 String              @id @default(cuid())
  scenarioId         String
  scenario           FeasibilityScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  label              String
  rooms              Decimal?            @db.Decimal(5, 2)
  unitCount          Int
  disposition        FeasibilityUnitDisposition @default(UNCLASSIFIED)
  netAreaSqm         Decimal?            @db.Decimal(18, 4)
  grossAreaSqm       Decimal?            @db.Decimal(18, 4)
  saleableAreaSqm    Decimal?            @db.Decimal(18, 4)
  balconyAreaSqm     Decimal?            @db.Decimal(18, 4)
  storageAreaSqm     Decimal?            @db.Decimal(18, 4)
  parkingSpaces      Int                 @default(0)
  floorFrom          Int?
  floorTo            Int?
  orientation        String?
  pricePerSqm        Decimal?            @db.Decimal(18, 4)
  fixedUnitPrice     Decimal?            @db.Decimal(18, 2)
  balconyPricePerSqm Decimal?            @db.Decimal(18, 4)
  parkingPrice       Decimal?            @db.Decimal(18, 2)
  storagePricePerSqm Decimal?            @db.Decimal(18, 4)
  adjustmentFactor   Decimal?            @db.Decimal(12, 8)
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean             @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  replacementAllocations FeasibilityReplacementAllocation[]

  @@index([scenarioId])
  @@map("feasibility_unit_mix_lines")
}

/// Which replacement flat goes to which owner holding, and in what exact share.
///
/// The engine already reconciles these (REPLACEMENT_ALLOCATION_INCOMPLETE,
/// REPLACEMENT_REFERENCE_DUPLICATE, REPLACEMENT_ALLOCATION_ON_SALE_UNITS) and
/// has done since 0cbdefb — against a relation that did not exist in this
/// schema, through a helper that yielded an empty list. Every one of those
/// checks was therefore inert. This is the model they were written for.
///
/// The share is an INTEGER FRACTION, not a decimal, for the same reason
/// OwnerApartment's is: thirds. 1/3 + 1/3 + 1/3 must be exactly one unit, and
/// 0.333 × 3 is not. `replacementAllocationSummary` sums them in BigInt.
model FeasibilityReplacementAllocation {
  id               String                 @id @default(cuid())
  unitMixLineId    String
  unitMixLine      FeasibilityUnitMixLine @relation(fields: [unitMixLineId], references: [id], onDelete: Cascade)

  /// The replacement flat being allocated, as the scenario names it ("A-3").
  /// A plan-level label rather than an Apartment id: the flats being allocated
  /// do not exist yet and have no row to point at.
  unitReference    String

  /// The existing holding that receives it. Restrict, not Cascade: an owner
  /// holding that a signed scenario allocates a flat to must not disappear
  /// silently underneath it.
  ownerApartmentId String
  ownerApartment   OwnerApartment         @relation(fields: [ownerApartmentId], references: [id], onDelete: Restrict)

  shareNumerator   Int                    @default(1)
  shareDenominator Int                    @default(1)

  notes            String?
  createdById      String
  updatedById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  /// One holding cannot be allocated the same replacement flat twice. The
  /// engine flags it as `invalid` too; this stops it reaching the engine.
  @@unique([unitMixLineId, unitReference, ownerApartmentId])
  @@index([unitMixLineId])
  @@index([ownerApartmentId])
  @@map("feasibility_replacement_allocations")
}

/// Revenue is expressed as explicit scenario inputs, never as a saved output.
/// Residential units can be priced through UnitMix; this line model handles
/// commercial, employment, parking, storage and other revenue components.
model FeasibilityRevenueLine {
  id                 String                   @id @default(cuid())
  scenarioId         String
  scenario           FeasibilityScenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category           FeasibilityRevenueCategory
  label              String
  quantity           Decimal?                 @db.Decimal(18, 4)
  unit               String?
  saleableAreaSqm    Decimal?                 @db.Decimal(18, 4)
  pricePerSqm        Decimal?                 @db.Decimal(18, 4)
  fixedUnitPrice     Decimal?                 @db.Decimal(18, 2)
  annualNoi          Decimal?                 @db.Decimal(18, 2)
  capitalizationRate Decimal?                 @db.Decimal(12, 8)
  vatTreatment       FeasibilityVatTreatment  @default(VAT_EXCLUDED)
  vatRate            Decimal?                 @db.Decimal(7, 6)
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence    @default(UNKNOWN)
  isVerified         Boolean                  @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([scenarioId, category])
  @@map("feasibility_revenue_lines")
}

/// A single cost component. Exactly one calculation basis is interpreted by
/// the calculation layer: quantity×unitCost, fixedAmount, or percentage of a
/// named calculated base. The database preserves all inputs for auditability.
model FeasibilityCostLine {
  id                 String                   @id @default(cuid())
  scenarioId         String
  scenario           FeasibilityScenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category           FeasibilityCostCategory
  label              String
  quantity           Decimal?                 @db.Decimal(18, 4)
  unit               String?
  unitCost           Decimal?                 @db.Decimal(18, 4)
  fixedAmount        Decimal?                 @db.Decimal(18, 2)
  percentage         Decimal?                 @db.Decimal(12, 8)
  percentageBase     String?
  vatTreatment       FeasibilityVatTreatment  @default(VAT_EXCLUDED)
  vatRate            Decimal?                 @db.Decimal(7, 6)
  escalationRate     Decimal?                 @db.Decimal(12, 8)
  contingencyRate    Decimal?                 @db.Decimal(12, 8)
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence    @default(UNKNOWN)
  isVerified         Boolean                  @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([scenarioId, category])
  @@map("feasibility_cost_lines")
}

/// One financing input set per scenario. Monetary amounts are before VAT;
/// rates are decimal fractions (for example 0.05, not a floating percentage).
model FeasibilityFinancingAssumption {
  id                 String              @id @default(cuid())
  scenarioId         String              @unique
  scenario           FeasibilityScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  debtAmount         Decimal?            @db.Decimal(18, 2)
  equityAmount       Decimal?            @db.Decimal(18, 2)
  ltc                Decimal?            @db.Decimal(12, 8)
  ltv                Decimal?            @db.Decimal(12, 8)
  annualInterestRate Decimal?            @db.Decimal(12, 8)
  arrangementFeeRate Decimal?            @db.Decimal(12, 8)
  guaranteeFeeRate   Decimal?            @db.Decimal(12, 8)
  graceMonths        Int?
  financingMonths    Int?
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence @default(UNKNOWN)
  isVerified         Boolean             @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("feasibility_financing_assumptions")
}

/// Timeline phases are explicit inputs. Cash flow allocation is calculated
/// later from these dates/durations rather than embedded inside the UI.
model FeasibilityTimelinePhase {
  id                 String                       @id @default(cuid())
  scenarioId         String
  scenario           FeasibilityScenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  kind               FeasibilityTimelinePhaseKind
  label              String
  startDate          DateTime?
  endDate            DateTime?
  durationMonths     Int?
  dependencyPhaseId  String?
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence        @default(UNKNOWN)
  isVerified         Boolean                      @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([scenarioId, kind])
  @@map("feasibility_timeline_phases")
}

/// Monthly cash-flow input. Revenue/cost timing is never guessed: allocations
/// are explicit, traceable and reconciled to their source lines by the engine.
/// Priority ordering for the equity waterfall. Lower `priority` is paid first.
enum FeasibilityEquityTrancheKind {
  SENIOR
  JUNIOR
  SPONSOR
}

/// How a tranche's preferred return accrues on capital it has not yet had back.
enum FeasibilityPreferredReturnAccrual {
  /// Accrues on unreturned capital only; unpaid preference does not itself accrue.
  SIMPLE
  /// Unpaid preference joins the accrual base, so deferred preference costs more.
  COMPOUNDED
}

/// A layer of equity with its own priority, hurdle and residual share.
///
/// Contributions are NOT stored here: they are the scenario's existing EQUITY
/// INFLOW cash-flow allocations, attributed to a tranche through
/// `FeasibilityCashFlowAllocation.sourceLineId`. This row carries only the
/// TERMS — who is paid in what order, on what hurdle, for what share of the
/// residual. The money itself stays in the one cash-flow model the rest of the
/// engine already reads.
model FeasibilityEquityTranche {
  id                    String                       @id @default(cuid())
  tenantId              String
  tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenarioId            String
  scenario              FeasibilityScenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  name                  String
  kind                  FeasibilityEquityTrancheKind @default(SENIOR)
  /// Lower is paid first. Ties are resolved by creation order, and flagged.
  priority              Int
  /// What the investor undertook to put in, for checking against what the cash flow actually draws.
  commitment            Decimal?                     @db.Decimal(18, 2)
  /// Annual hurdle, as a decimal fraction. Null means this tranche has no preferred return.
  preferredReturnRate   Decimal?                     @db.Decimal(12, 8)
  preferredReturnAccrual FeasibilityPreferredReturnAccrual @default(COMPOUNDED)
  /// Share of the residual profit after capital and preference, as a decimal fraction.
  profitSharePercent    Decimal                      @db.Decimal(12, 8)
  classification        FeasibilityDataClassification @default(ASSUMPTION)
  confidence            FeasibilityConfidence        @default(UNKNOWN)
  isVerified            Boolean                      @default(false)
  sourceId              String?
  notes                 String?
  createdById           String
  updatedById           String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([scenarioId, name])
  @@index([scenarioId, priority])
  @@index([tenantId])
  @@map("feasibility_equity_tranches")
}

model FeasibilityCashFlowAllocation {
  id                 String                       @id @default(cuid())
  scenarioId         String
  scenario           FeasibilityScenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  direction          FeasibilityCashFlowDirection
  sourceKind         FeasibilityCashFlowSourceKind
  sourceLineId       String?
  label              String
  amount             Decimal                      @db.Decimal(18, 2)
  classification     FeasibilityDataClassification @default(ASSUMPTION)
  confidence         FeasibilityConfidence        @default(UNKNOWN)
  isVerified         Boolean                      @default(false)
  sourceId           String?
  sourceDate         DateTime?
  notes              String?
  createdById        String
  updatedById        String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([scenarioId, periodStart])
  @@index([scenarioId, sourceKind, sourceLineId])
  @@map("feasibility_cash_flow_allocations")
}

/// Per-owner holding compensation. It uses the existing ownership registry;
/// the same OwnerApartment share can have one independently auditable set of
