/// Outbound message lifecycle, consumed by the dispatcher in
/// services/api-gateway/src/messaging/.
///
///   QUEUED     — recorded, waiting to be claimed by a worker.
///   PROCESSING — atomically claimed by exactly one worker; a provider call is
///                in flight. Rows stuck here past a timeout are re-queued.
///   SENT       — a provider accepted the message. NEVER set without a
///                successful provider call.
///   DELIVERED  — the provider confirmed delivery (webhook / status poll).
///   READ       — the recipient read it (WhatsApp/portal only).
///   FAILED     — permanently failed: attempts exhausted, or a non-retryable
///                provider rejection.
///   CANCELLED  — withdrawn by a human or by the system before it was sent.
enum MessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

