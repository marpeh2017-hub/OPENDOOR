  CONSTRAINT "saved_reports_pkey" PRIMARY KEY ("id"),
  CONSTRAINT "saved_reports_tenantId_fkey"  FOREIGN KEY ("tenantId")  REFERENCES "tenants"("id") ON DELETE CASCADE,
  CONSTRAINT "saved_reports_projectId_fkey" FOREIGN KEY ("projectId") REFERENCES "projects"("id")
);

CREATE INDEX IF NOT EXISTS "saved_reports_tenantId_idx" ON "saved_reports"("tenantId");

-- ────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS "workflows" (
  "id"        TEXT          NOT NULL DEFAULT gen_random_uuid()::TEXT,
  "tenantId"  TEXT          NOT NULL,
  "name"      TEXT          NOT NULL,
  "stage"     "ProjectStage",
