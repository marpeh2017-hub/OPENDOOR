CREATE TABLE IF NOT EXISTS "saved_reports" (
  "id"               TEXT        NOT NULL DEFAULT gen_random_uuid()::TEXT,
  "tenantId"         TEXT        NOT NULL,
  "projectId"        TEXT,
  "name"             TEXT        NOT NULL,
