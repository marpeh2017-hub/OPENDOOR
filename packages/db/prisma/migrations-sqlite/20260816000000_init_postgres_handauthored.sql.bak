DO $$ BEGIN
  CREATE TYPE "Language" AS ENUM ('he', 'en', 'ru', 'ar');
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "UserRole" AS ENUM (
    'SUPER_ADMIN', 'COMPANY_ADMIN', 'CEO', 'PROJECT_MANAGER',
    'RESIDENT_RELATIONS_MANAGER', 'FIELD_AGENT', 'LAWYER',
    'ARCHITECT', 'ENGINEER', 'DEVELOPER_REP', 'MUNICIPALITY_USER',
    'EXTERNAL_CONSULTANT', 'RESIDENT'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "ProjectStatus" AS ENUM ('ACTIVE', 'ON_HOLD', 'COMPLETED', 'CANCELLED', 'ARCHIVED');
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "ProjectStage" AS ENUM (
    'DISCOVERY', 'FEASIBILITY', 'RESIDENT_ORGANIZATION', 'SIGNATURES',
    'DEVELOPER_SELECTION', 'PLANNING', 'MUNICIPAL_APPROVAL', 'PERMIT',
    'EVACUATION', 'CONSTRUCTION', 'DELIVERY', 'POST_DELIVERY'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "LeadStatus" AS ENUM (
    'NEW', 'CONTACTED', 'MEETING_SCHEDULED', 'INTERESTED', 'NEGOTIATION', 'SIGNED', 'LOST'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "LeadSource" AS ENUM (
    'WEBSITE', 'REFERRAL', 'WHATSAPP', 'PHONE', 'SOCIAL_MEDIA',
    'CAMPAIGN', 'DOOR_TO_DOOR', 'EVENT', 'PARTNER', 'OTHER'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "SignatureStatus" AS ENUM (
    'DRAFT', 'SENT', 'VIEWED', 'PENDING', 'SIGNED', 'REJECTED', 'EXPIRED'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "SignatureProvider" AS ENUM (
    'DOCUSIGN', 'ADOBE_SIGN', 'SIGNNOW', 'COMSIGN', 'MANUAL'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
  CREATE TYPE "DocumentCategory" AS ENUM (
    'CONTRACT', 'ID_DOCUMENT', 'LAND_REGISTRY', 'POWER_OF_ATTORNEY',
