DO $$ BEGIN
  CREATE TYPE "MessageChannel" AS ENUM (
    'WHATSAPP', 'SMS', 'EMAIL', 'PUSH', 'IN_APP', 'PORTAL'
  );
EXCEPTION WHEN duplicate_object THEN NULL; END $$;

DO $$ BEGIN
