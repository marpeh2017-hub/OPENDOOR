CREATE TABLE IF NOT EXISTS "audit_logs" (
  "id"        TEXT          NOT NULL DEFAULT gen_random_uuid()::TEXT,
  "tenantId"  TEXT          NOT NULL,
  "userId"    TEXT,
  "action"    "AuditAction" NOT NULL,
