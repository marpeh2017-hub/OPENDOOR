# ═══════════════════════════════════════════════════════════════════════════
#  Urban Renewal OS — PRODUCTION environment
# ═══════════════════════════════════════════════════════════════════════════
#
# This file is the authoritative production reference. `.env.example` documents
# every variable the code reads, including optional ones with their defaults;
# this file lists what a production deployment must actually set.
#
# Each value says where it goes:
#   [API]                       the api-gateway service
#   [WEBSITE] [CRM] [PORTAL]    the Next.js projects apps/website, apps/crm,
#                               apps/portal
# A value marked for more than one place must be identical in each.
#
# The API REFUSES TO START in production unless all of these are set:
#   DATABASE_URL, JWT_SECRET, REDIS_URL, FIELD_ENCRYPTION_KEY,
#   MESSAGING_SIMULATE, CRM_URL, PORTAL_URL, WEB_URL, WEBSITE_URL,
#   and one SMS provider (VONAGE_API_KEY, TWILIO_ACCOUNT_SID or INFORU_USERNAME).
#
# Host-neutral: nothing here assumes a particular provider. The example values
# name one only to show the shape.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (Railway PostgreSQL — copy from Railway dashboard) ───────────────
# [API] Migrations run on every boot (start.sh: prisma migrate deploy).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"

# ── JWT (generate with: openssl rand -base64 64) ─────────────────────────────
# [API]
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# ── App URLs (replace with your actual domains) ───────────────────────────────
# [WEBSITE] [CRM] [PORTAL] The gateway's public address.
NEXT_PUBLIC_API_URL="https://api.odg.co.il"
# [API] Every personal link sent by SMS, email or WhatsApp points here, so this
# must be the portal's final public address. Also a CORS origin.
PORTAL_URL="https://portal.odg.co.il"
# [API] [PORTAL] The public website. The API refreshes it after a CRM publish
# (with CMS_REVALIDATE_SECRET) and allows it as a CORS origin; the portal links
# to its terms and privacy pages.
WEBSITE_URL="https://odg.co.il"
# [WEBSITE] The site's canonical address: metadata, sitemap, robots.txt.
NEXT_PUBLIC_SITE_URL="https://odg.co.il"
# [WEBSITE] The personal area. The header's "אזור אישי" and /portal/register go
# here; unset, they fall back to the site's own resident-portal page.
NEXT_PUBLIC_PORTAL_URL="https://portal.odg.co.il"
# [CRM] The site editor's links to the live site; unset, they point at
# http://localhost:3003.
NEXT_PUBLIC_WEBSITE_URL="https://odg.co.il"

# ── CORS origins ──────────────────────────────────────────────────────────────
# [API] PORTAL_URL and WEBSITE_URL above are origins too. All four are required
# in production: a missing one stops the API at boot.
CRM_URL="https://crm.odg.co.il"
# apps/web, the retired CRM-sales site, which is not deployed. Still required,
# so it gets the CRM's address rather than being left empty.
WEB_URL="https://crm.odg.co.il"

# ── Tenant ────────────────────────────────────────────────────────────────────
# ONE slug, the same everywhere: the tenant the bootstrap script creates
# (BOOTSTRAP_TENANT_SLUG, below), the CMS the website reads, the CMS the page
# import writes to (CMS_IMPORT_TENANT, below), and where website leads land.
#
# [API] Website enquiries and protocols started on the website. Set the slug or
# the id; the tenant is selected by the API only.
PUBLIC_LEAD_TENANT_SLUG="opendoor"
PUBLIC_LEAD_TENANT_ID=""
# [WEBSITE] Unset, the site reads the demo tenant "opendoor-demo".
CMS_TENANT_SLUG="opendoor"

# Required when the API runs behind one reverse proxy/load balancer.
TRUST_PROXY="1"

# [WEBSITE] Where the website's forms send enquiries.
NEXT_PUBLIC_LEADS_ENDPOINT="https://api.odg.co.il/api/v1/public/leads"

# ── Messages: SMS, email, WhatsApp ────────────────────────────────────────────
# [API] REQUIRED, "true" or "false"; in production there is no default and the
# API will not start without it. "false" sends real messages to residents,
# "true" simulates every message and nothing leaves. Do not copy
# MESSAGING_SIMULATE_EXCEPT from a development .env: production ignores it and
# logs an error.
MESSAGING_SIMULATE="false"

# [API] SMS: one provider is REQUIRED, or the API will not start. Personal-area
# sign-in codes, invitations and personal form links go by SMS. Vonage is used
# when its key is set, then Twilio, then InforU.
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
# The sender residents see. Israeli networks reject most alphanumeric sender
# IDs (Vonage status 15), so use a sender Vonage confirms for Israel.
VONAGE_FROM="OpenDoor"
# Alternatives:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# INFORU_USERNAME=""
# INFORU_API_KEY=""

# [API] Email: Resend or SendGrid (Resend when both keys are set). EMAIL_FROM is
# a bare address (SendGrid takes no display name) on a domain verified with the
# provider. Without both a key and EMAIL_FROM no email goes out, and
# personal-area sign-in by email answers "unavailable", so residents sign in by
# phone.
RESEND_API_KEY=""
# SENDGRID_API_KEY=""
EMAIL_FROM="info@odg.co.il"

# [API] WhatsApp Business (Meta Cloud API). Optional: the CRM's WhatsApp buttons
# for personal links open WhatsApp by hand and need none of this. It is only
# for automatic WhatsApp messages, which Meta allows only as approved templates.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_API_VERSION=""

# [API] New-lead alert: the office mobile to tell when a lead arrives from the
# website. Unset, no alert is sent.
LEAD_NOTIFY_PHONE=""
# "SMS" or "WHATSAPP" (the default). WhatsApp needs the Meta setup above and an
# approved template; SMS works with the SMS provider.
LEAD_NOTIFY_CHANNEL="SMS"

# ── Forms ─────────────────────────────────────────────────────────────────────
# [API] The ID number printed after the preparer's name on the signed
# representation protocol. Kept in the gateway's environment so it never
# reaches a browser. Unset, the line shows the name alone.
PROTOCOL_PREPARER_ID_NUMBER=""

# ── Website content and chat ─────────────────────────────────────────────────
# [API] [WEBSITE] Same value in both: lets a CRM publish refresh the site at
# once (the API posts to WEBSITE_URL/api/revalidate with it).
# Generate with: openssl rand -base64 32
CMS_REVALIDATE_SECRET=""

# [API] [WEBSITE] Claude, for the personal area's chat (API) and the website's
# questions chat (WEBSITE). Unset, both chats answer that they are unavailable.
ANTHROPIC_API_KEY=""

# [WEBSITE] Leave unset in production. "true" builds the preview site, which
# shows the notes that mark copy still owed.
# WEBSITE_PREVIEW=""

# ── File Storage (Cloudflare R2 or AWS S3) ────────────────────────────────────
# [API] Needed for anything uploaded: the CRM's Excel import of owners and
# residents, documents, and images from the site editor. The API starts
# without it, but those uploads fail.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="urban-renewal-prod"
S3_REGION="auto"

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED. `RedisModule` THROWS on startup in production without it.
# Sessions, JWT revocation, OTP codes and rate limits all live here.
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

# ── PII encryption ───────────────────────────────────────────────────────────
# REQUIRED. `FieldEncryptionService` THROWS on startup in production without it.
# Exactly 32 bytes, base64. Encrypts national IDs at rest.
#
# ROTATING THIS ORPHANS EVERY VALUE ALREADY ENCRYPTED WITH THE OLD KEY.
# There is no re-encryption path today. Set it once, back it up somewhere other
# than the database it protects, and do not change it without a migration plan.
#
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# ── Malware scanning ─────────────────────────────────────────────────────────
# OFF by default, which means uploaded documents are stored uninspected.
# Turn it on for any environment that accepts real files, and run clamd.
MALWARE_SCAN_ENABLED="true"
MALWARE_SCAN_FAIL_CLOSED="true"
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# ── ComSign Digital Signature ────────────────────────────────────────────────
COMSIGN_API_KEY=""
COMSIGN_API_URL="https://api.comsign.co.il"
# Required to accept ComSign webhooks at all — the endpoint fails closed, so an
# unset secret means every webhook from this provider is rejected. Once
# COMSIGN_API_KEY is set, the API will not start without it.
COMSIGN_WEBHOOK_SECRET=""

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=4000

# ═══════════════════════════════════════════════════════════════════════════
#  ONE-TIME SETUP, not service settings
# ═══════════════════════════════════════════════════════════════════════════
#
# Deploy from the pushed commit (GitHub), never by uploading a working folder:
# the API image copies packages/db and services/api-gateway whole, so any
# untracked migration lying in a local folder would reach the live database.
#
# 1. The first tenant and CRM admin, once, on the API service after its first
#    deploy. The image has dist/ but no dev tools:
#      BOOTSTRAP_TENANT_NAME="OpenDoor Group" \
#      BOOTSTRAP_TENANT_SLUG="opendoor" \
#      BOOTSTRAP_ADMIN_EMAIL="..." \
#      BOOTSTRAP_ADMIN_PASSWORD="..." \
#      node dist/scripts/bootstrap-tenant.js
#    The password needs at least 12 characters. Optional: BOOTSTRAP_ADMIN_FIRST_NAME,
#    BOOTSTRAP_ADMIN_LAST_NAME, BOOTSTRAP_ADMIN_PHONE. Re-running changes nothing.
#
# 2. The CMS pages trust, about, why-organizer and how-we-work. In production
#    the website serves them only from the CMS, so each answers 404 until it is
#    imported and published. After step 1, export each page with
#    apps/website/scripts/export-page-fixture.ts and import it with
#    services/api-gateway/scripts/import-cms-page.ts --publish (usage in each
#    file's header), with DATABASE_URL pointing at the production database and
#    CMS_IMPORT_TENANT set to the tenant slug (it defaults to "opendoor").
# ═══════════════════════════════════════════════════════════════════════════
