# ═══════════════════════════════════════════════════════════════════════════
#  Urban Renewal OS — environment reference
# ═══════════════════════════════════════════════════════════════════════════
#
# Generated from the ACTUAL `process.env` reads in the source, including the
# ones behind `boolEnv()` / `intEnv()` helpers that a plain grep for
# `process.env.X` does not find.
#
# The previous version of this file documented variables the code never reads
# (AWS_*, RABBITMQ_URL, ELASTICSEARCH_*, DATADOG_API_KEY) and used wrong names
# for ones it does (AWS_ACCESS_KEY_ID for S3_ACCESS_KEY, TWILIO_FROM_NUMBER for
# TWILIO_FROM, WHATSAPP_API_KEY for WHATSAPP_ACCESS_TOKEN). Following it
# produced a deployment that could not start.
#
# ── HOW TO READ THIS FILE ──────────────────────────────────────────────────
#
#   [REQUIRED]      the process refuses to start without it (in production)
#   [REQUIRED-PROD] required in production only; has a dev fallback
#   no marker       optional; the documented default applies
#
# Copy to `.env` for local development. For production see
# `.env.production.example`, which is the authoritative production reference.
#
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  CORE — API GATEWAY (services/api-gateway)
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV="development"                    # development | test | production
PORT="4000"

# [REQUIRED] PostgreSQL. Prisma reads this directly.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/urban_renewal_os?schema=public"

# [REQUIRED] JWT signing key. `JwtStrategy` throws at construction without it.
# Also the source of the OTP storage pepper, so changing it invalidates any
# OTP currently in flight (harmless — they live 5 minutes).
# Generate with: openssl rand -base64 64
JWT_SECRET=""

# [REQUIRED-PROD] Redis. `RedisModule` throws in production without it.
# Sessions, JWT revocation, OTP codes and rate limits all live here.
REDIS_URL="redis://127.0.0.1:6379"

# [REQUIRED-PROD] AES-256-GCM key for encrypted PII (national IDs).
# `FieldEncryptionService` THROWS in production without it, and falls back to a
# clearly-labelled insecure dev key otherwise. Must be exactly 32 bytes, base64.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""


# ───────────────────────────────────────────────────────────────────────────
#  CORS / SERVICE URLS
# ───────────────────────────────────────────────────────────────────────────
#
# The gateway's CORS allowlist names these exact origins, and the CRM sets an
# httpOnly cookie scoped to its own origin. A mismatched port breaks
# authentication silently rather than loudly — see .claude/launch.json.

CRM_URL="http://localhost:3001"
PORTAL_URL="http://localhost:3002"
WEB_URL="http://localhost:3000"
WEBSITE_URL="http://localhost:3003"       # used for CMS preview/revalidate links

# Set when the gateway runs behind a reverse proxy, so the rate limiter buckets
# on the real client IP instead of the proxy's. Value is passed to Express
# `trust proxy` (e.g. "1", "loopback", or a CIDR).
TRUST_PROXY=""


# ───────────────────────────────────────────────────────────────────────────
#  OBJECT STORAGE (S3-compatible: MinIO locally, R2 / S3 / Spaces in prod)
# ───────────────────────────────────────────────────────────────────────────
#
# Keys are tenant-prefixed (`<tenantId>/...`) and every read, write and delete
# asserts that prefix, so a bucket is safe to share across tenants.

S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="urban-renewal"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""


# ───────────────────────────────────────────────────────────────────────────
#  SMS — OTP delivery
# ───────────────────────────────────────────────────────────────────────────
#
# There is no SMS_PROVIDER switch. The provider is chosen by which credentials
# are present, in this order: Vonage → Twilio → Inforu → none.
#
# With none configured the gateway logs "No SMS provider configured — OTP will
# not be delivered" at boot and THROWS on send in production. Resident portal
# login and signature OTP both depend on this.

VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM="OpenDoor"                    # alphanumeric sender id

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                            # E.164, e.g. +972500000000

INFORU_USERNAME=""                        # Israeli provider
INFORU_API_KEY=""


# ───────────────────────────────────────────────────────────────────────────
#  WHATSAPP (Meta Cloud API)
# ───────────────────────────────────────────────────────────────────────────

WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"


# ───────────────────────────────────────────────────────────────────────────
#  EMAIL
# ───────────────────────────────────────────────────────────────────────────
#
# Resend is tried first, then SendGrid.

RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@opendoor.co.il"


# ───────────────────────────────────────────────────────────────────────────
#  MESSAGING WORKER — the database-backed outbox
# ───────────────────────────────────────────────────────────────────────────
#
# MESSAGING_SIMULATE wins over configured credentials, deliberately: a
# developer with a real credential copied from staging must not start texting
# residents merely by running the API locally. Defaults to ON everywhere except
# production, where an unconfigured channel is a hard failure instead of a
# silent black hole.

MESSAGING_SIMULATE=""                     # default: true unless NODE_ENV=production

# Lets ONE specific phone number through while MESSAGING_SIMULATE stays on for
# everything else — for deliberately sending yourself a real OTP without
# flipping the global flag (see the 2026-09-09 incident note in
# sms.service.ts: turning MESSAGING_SIMULATE off sent 24 queued messages at
# once). Comma-separated E.164 or local Israeli numbers. Read only by the OTP
# send path, not by the outbox worker. Ignored, loudly, when NODE_ENV=production.
MESSAGING_SIMULATE_EXCEPT=""              # e.g. "0548018613"

MESSAGE_WORKER_ENABLED=""                 # default: true unless NODE_ENV=test
MESSAGE_POLL_INTERVAL_MS="5000"
MESSAGE_BATCH_SIZE="20"
MESSAGE_MAX_ATTEMPTS="5"
MESSAGE_BACKOFF_BASE_SECONDS="30"
MESSAGE_BACKOFF_MAX_SECONDS="3600"
MESSAGE_PROVIDER_TIMEOUT_MS="15000"
MESSAGE_STUCK_AFTER_MS="120000"           # requeue rows a dead worker left claimed


# ───────────────────────────────────────────────────────────────────────────
#  MEETINGS
# ───────────────────────────────────────────────────────────────────────────

MEETING_REMINDER_ENABLED=""               # default: true unless NODE_ENV=test
MEETING_REMINDER_SCAN_INTERVAL_MS="60000"
MEETING_REMINDER_OFFSETS_MINUTES="1440,120"
MEETING_TOKEN_MAX_DAYS="90"
MEETING_TOKEN_GRACE_DAYS="2"
MEETING_TOKEN_MAX_USES="20"


# ───────────────────────────────────────────────────────────────────────────
#  NOTIFICATION RETENTION
# ───────────────────────────────────────────────────────────────────────────
#
# Only READ notifications are ever deleted. Audit rows and signature evidence
# are never touched. A per-tenant override lives on `Tenant`.

NOTIFICATION_RETENTION_ENABLED=""         # default: true unless NODE_ENV=test
NOTIFICATION_RETENTION_DAYS="180"
NOTIFICATION_RETENTION_INTERVAL_MS="21600000"
NOTIFICATION_RETENTION_BATCH_SIZE="1000"


# ───────────────────────────────────────────────────────────────────────────
#  DIGITAL SIGNATURES
# ───────────────────────────────────────────────────────────────────────────
#
# With no external provider configured the NATIVE provider is used: SMS OTP,
# legally valid for regular electronic signatures in Israel.
#
# The webhook endpoint FAILS CLOSED. An unset secret means requests from that
# provider are rejected, not accepted unverified.

COMSIGN_API_KEY=""
COMSIGN_WEBHOOK_SECRET=""                 # required to accept ComSign webhooks
DOCUSIGN_CLIENT_ID=""
DOCUSIGN_HMAC_KEY=""                      # required to accept DocuSign webhooks


# ───────────────────────────────────────────────────────────────────────────
#  DOCUMENTS — malware scanning and limits
# ───────────────────────────────────────────────────────────────────────────
#
# Scanning is OFF by default and uploads are then stored uninspected. Enable it
# in any environment that accepts real files.

MALWARE_SCAN_ENABLED="false"
MALWARE_SCAN_FAIL_CLOSED="true"           # reject the upload if clamd is unreachable
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
CLAMAV_MAX_BYTES="26214400"

MAX_DOCUMENT_BYTES="26214400"             # 25 MB
MAX_IMPORT_BYTES="10485760"               # 10 MB
MAX_IMPORT_ROWS="5000"


# ───────────────────────────────────────────────────────────────────────────
#  PDF RENDERING
# ───────────────────────────────────────────────────────────────────────────
#
# Headless Chrome/Edge renders HTML to PDF, because pdfkit does not shape
# Hebrew or handle mixed-direction numbers correctly. Falls back to the usual
# Windows install paths when unset.

PDF_BROWSER_PATH=""


# ───────────────────────────────────────────────────────────────────────────
#  GEOCODING (Nominatim / OpenStreetMap)
# ───────────────────────────────────────────────────────────────────────────
#
# The public instance is a donated resource. A descriptive User-Agent naming
# the application and a contact is MANDATORY under its usage policy; a generic
# agent gets blocked. Rate limiting to 1 req/s is enforced in code.

NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="UrbanRenewalOS/1.0"
NOMINATIM_CONTACT_EMAIL=""


# ───────────────────────────────────────────────────────────────────────────
#  AUTOMATIONS — outbound webhook egress
# ───────────────────────────────────────────────────────────────────────────
#
# Comma-separated hosts and domain suffixes. Private, loopback and link-local
# ranges are blocked BEFORE this list is consulted, and putting an internal
# address here is a validation error rather than an allowlist entry.

AUTOMATION_WEBHOOK_ALLOWLIST=""


# ───────────────────────────────────────────────────────────────────────────
#  PUBLIC LEAD CAPTURE (website contact forms)
# ───────────────────────────────────────────────────────────────────────────
#
# Which tenant an unauthenticated public lead belongs to. Set one.

PUBLIC_LEAD_TENANT_SLUG="opendoor-demo"
PUBLIC_LEAD_TENANT_ID=""


# ───────────────────────────────────────────────────────────────────────────
#  CMS
# ───────────────────────────────────────────────────────────────────────────

CMS_REVALIDATE_SECRET=""                  # shared with the website's revalidate route
CMS_IMPORT_TENANT="opendoor-demo"         # used by the scripts/ import helpers only


# ═══════════════════════════════════════════════════════════════════════════
#  APPS — these belong in each app's own .env.local, not here
# ═══════════════════════════════════════════════════════════════════════════

# ── apps/crm ───────────────────────────────────────────────────────────────
# API_GATEWAY_URL              server-side BFF target, e.g. http://localhost:4000
# NEXT_PUBLIC_API_URL          gateway ORIGIN (no path), e.g. http://localhost:4000
# NEXT_PUBLIC_MAP_PROVIDER     maplibre | google
# NEXT_PUBLIC_MAP_API_KEY
# NEXT_PUBLIC_MAP_STYLE_URL
# NEXT_PUBLIC_MAX_DOCUMENT_BYTES

# ── apps/portal ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL          gateway ORIGIN, e.g. http://localhost:4000

# ── apps/website ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_LEADS_ENDPOINT
# ANTHROPIC_API_KEY           server-only (read by app/api/faq-chat/route.ts,
#                             never exposed to the browser). Without it the
#                             /faq chat widget shows "נסה שוב מאוחר יותר" on
#                             every message instead of erroring at build/boot.
